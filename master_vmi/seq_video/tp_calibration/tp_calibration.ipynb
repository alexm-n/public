  "cells": [
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import cv2\n",
        "import glob\n",
        "from google.colab.patches import cv2_imshow\n",
        "from google.colab import drive",
        "drive.mount('/content/drive')\n",
        "\n",
      ],
      "metadata": {
        "id": "uFHy1rMf-G42"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Parametres capteur\n",
        "largeur_capteur_mm = 6.17\n",
        "hauteur_capteur_mm = 4.55\n",
        "\n",
        "# Parametres capteur\n",
        "taille_carre_mm = 30.0\n",
        "colonnes_internes = 8\n",
        "lignes_internes = 5\n",
        "\n",
        "# Critères de terminaison\n",
        "criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 30, 0.001)\n",
        "\n",
        "# 3. Préparation des points objets (Mis à l'échelle en mm dès le départ)\n",
        "objp = np.zeros((lignes_internes * colonnes_internes, 3), np.float32)\n",
        "objp[:, :2] = np.mgrid[0:colonnes_internes, 0:lignes_internes].T.reshape(-1, 2) * taille_carre_mm\n",
        "\n",
        "# Chargement des images\n",
        "images = glob.glob('/content/drive/MyDrive/seq_data/*')\n",
        "print(f\"{len(images)} images trouvées dans le dossier.\")\n",
        "\n",
        "# Variables globales\n",
        "objpoints = []\n",
        "imgpoints = []\n",
        "images_valides = []"
      ],
      "metadata": {
        "id": "U0hA7CxL-IC-"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "for fname in images:\n",
        "    img = cv2.imread(fname)\n",
        "    if img is None:\n",
        "        continue\n",
        "\n",
        "    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
        "    ret, corners = cv2.findChessboardCorners(gray, (colonnes_internes, lignes_internes), None)\n",
        "\n",
        "    if ret == True:\n",
        "        objpoints.append(objp)\n",
        "        corners2 = cv2.cornerSubPix(gray, corners, (11,11), (-1,-1), criteria)\n",
        "        imgpoints.append(corners2)\n",
        "        images_valides.append(fname)\n",
        "\n",
        "        # Dessiner et afficher\n",
        "        img_show = cv2.drawChessboardCorners(img.copy(), (colonnes_internes, lignes_internes), corners2, ret)\n",
        "        print(f\"Succès pour : {fname}\")\n",
        "        cv2_imshow(img_show)\n",
        "    else:\n",
        "        print(f\"Échec de la détection pour : {fname}\")"
      ],
      "metadata": {
        "id": "JThArcoD-L00"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Calibration\n",
        "ret, mtx, dist, rvecs, tvecs = cv2.calibrateCamera(objpoints, imgpoints, gray.shape[::-1], None, None)\n",
        "\n",
        "print(\"Erreur de reprojection (RMS) :\", ret)\n",
        "print(\"\\nMatrice de la caméra (Intrinsèque) :\\n\", mtx)\n",
        "print(\"\\nCoefficients de distorsion :\\n\", dist)\n",
        "\n",
        "fovx, fovy, focalLength, principalPoint, aspectRatio = cv2.calibrationMatrixValues(\n",
        "    cameraMatrix=mtx,\n",
        "    imageSize=gray.shape[::-1],\n",
        "    apertureWidth=largeur_capteur_mm,\n",
        "    apertureHeight=hauteur_capteur_mm\n",
        ")\n",
        "\n",
        "focale_metre = focalLength / 1000.0\n",
        "\n",
        "print(f\"Champ de vision X : {fovx:.2f} degrés\")\n",
        "print(f\"Champ de vision Y : {fovy:.2f} degrés\")\n",
        "print(f\"Focale de la caméra : {focale_metre:.6f} mètres\")\n",
        "print(f\"Centre optique : {principalPoint}\")"
      ],
      "metadata": {
        "id": "Z9hIO8rR-wsF"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Repere3D\n",
        "longueur_axe = 3 * taille_carre_mm\n",
        "axis = np.float32([[longueur_axe,0,0], [0,longueur_axe,0], [0,0,-longueur_axe]]).reshape(-1,3)\n",
        "\n",
        "def draw_axes(img, corners, imgpts):\n",
        "    corner = tuple(corners[0].ravel().astype(int))\n",
        "    img = cv2.line(img, corner, tuple(imgpts[0].ravel().astype(int)), (255,0,0), 5) # Axe X Bleu\n",
        "    img = cv2.line(img, corner, tuple(imgpts[1].ravel().astype(int)), (0,255,0), 5) # Axe Y Vert\n",
        "    img = cv2.line(img, corner, tuple(imgpts[2].ravel().astype(int)), (0,0,255), 5) # Axe Z Rouge\n",
        "    return img\n",
        "\n",
        "for fname in images_valides:\n",
        "    img = cv2.imread(fname)\n",
        "    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
        "    ret, corners = cv2.findChessboardCorners(gray, (colonnes_internes, lignes_internes), None)\n",
        "\n",
        "    if ret:\n",
        "        corners2 = cv2.cornerSubPix(gray, corners, (11,11), (-1,-1), criteria)\n",
        "        ret_pnp, rvecs_img, tvecs_img = cv2.solvePnP(objp, corners2, mtx, dist)\n",
        "        imgpts, jac = cv2.projectPoints(axis, rvecs_img, tvecs_img, mtx, dist)\n",
        "\n",
        "        img_axes = draw_axes(img, corners2, imgpts)\n",
        "        print(f\"Repère 3D pour : {fname}\")\n",
        "        cv2_imshow(img_axes)"
      ],
      "metadata": {
        "id": "kFzjKfa5-2E1"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Cube3D\n",
        "taille_cube = 3 * taille_carre_mm\n",
        "axis_cube = np.float32([\n",
        "    [0, 0, 0], [0, taille_cube, 0], [taille_cube, taille_cube, 0], [taille_cube, 0, 0],\n",
        "    [0, 0, -taille_cube], [0, taille_cube, -taille_cube], [taille_cube, taille_cube, -taille_cube], [taille_cube, 0, -taille_cube]\n",
        "])\n",
        "\n",
        "def draw_cube(img, corners, imgpts):\n",
        "    imgpts = np.int32(imgpts).reshape(-1, 2)\n",
        "    img = cv2.drawContours(img, [imgpts[:4]], -1, (0, 255, 0), -3) # Plancher vert\n",
        "    for i, j in zip(range(4), range(4, 8)):\n",
        "        img = cv2.line(img, tuple(imgpts[i]), tuple(imgpts[j]), (255, 0, 0), 3) # Piliers bleus\n",
        "    img = cv2.drawContours(img, [imgpts[4:]], -1, (0, 0, 255), 3) # Toit rouge\n",
        "    return img\n",
        "\n",
        "for fname in images_valides:\n",
        "    img = cv2.imread(fname)\n",
        "    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n",
        "    ret, corners = cv2.findChessboardCorners(gray, (colonnes_internes, lignes_internes), None)\n",
        "\n",
        "    if ret:\n",
        "        corners2 = cv2.cornerSubPix(gray, corners, (11,11), (-1,-1), criteria)\n",
        "        ret_pnp, rvecs_img, tvecs_img = cv2.solvePnP(objp, corners2, mtx, dist)\n",
        "        imgpts, jac = cv2.projectPoints(axis_cube, rvecs_img, tvecs_img, mtx, dist)\n",
        "\n",
        "        img_cube = draw_cube(img, corners2, imgpts)\n",
        "        print(f\"Cube 3D pour : {fname}\")\n",
        "        cv2_imshow(img_cube)"
      ],
      "metadata": {
        "id": "1WvbvY2P-6Ra"
      },
      "execution_count": null,
      "outputs": []
    }
  ]
